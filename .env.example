# Local development works without credentials, using live public sources and browser storage.
# Production stays locked until the private workspace is configured.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_ALLOWED_EMAIL=
CRON_SECRET=

# Optional Ask Siggo. Keep the Groq organization on Free; do not enable paid billing.
# Enable Zero Data Retention in https://console.groq.com/settings/data-controls.
# Requires private sign-in. No live inference in credential-free local preview.
# Never use NEXT_PUBLIC_ or paste this key into chat. No live keys in CI.
GROQ_API_KEY=

# Optional. Generate a token at https://www.kaggle.com/settings/api. No download needed.
# Keep this server-only: never use a NEXT_PUBLIC_ prefix.
KAGGLE_API_TOKEN=

# Alternative: legacy credentials. Ignored when KAGGLE_API_TOKEN is set.
KAGGLE_USERNAME=
KAGGLE_KEY=
